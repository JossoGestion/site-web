---
import { site } from '../data/site.js';
---
<footer class="footer">
  <div class="footer__brand">
    <span class="footer__logo">
      <img src="/assets/jg-logo.webp" alt="" width="30" height="28" />
      <span>{site.name}</span>
    </span>
    <p>Conseil indépendant en gestion de patrimoine.<br />Siret n° {site.siret}</p>
  </div>
  <div class="footer__cols">
    <nav class="footer__col" aria-label="Plan du site">
      <strong>Plan du site</strong>
      <a href="/#services">Services</a>
      <a href="/#methode">Méthode</a>
      <a href="/#faq">FAQ</a>
      <a href="/#contact">Contact</a>
    </nav>
    <nav class="footer__col" aria-label="Informations">
      <strong>Informations</strong>
      <a href="/mentions-legales.html">Mentions légales</a>
      <a href="/politique-de-confidentialite.html">Politique de confidentialité</a>
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
    </nav>
  </div>
</footer>
