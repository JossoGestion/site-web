---
import Topbar from '../components/Topbar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import '../styles/global.css';

// og-image.jpg : version éditoriale retenue. Deux variantes écartées sont
// conservées dans _design-source/apercus-non-retenus/ : portrait de Vivien
// et photo du couple. Pour basculer, les remettre dans public/ et changer
// la valeur par défaut ci-dessous.
const { title, description, ogImage = '/og-image.jpg', ogAlt } = Astro.props;
// L'accueil doit se déclarer sur la racine, pas sur /index.html
const path = Astro.url.pathname.replace(/\/index\.html$/, '/');
const canonical = new URL(path, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);   // les réseaux exigent une URL absolue
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#08222E" />
  <link rel="canonical" href={canonical} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="JOSSO Gestion" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt ?? 'JOSSO Gestion, conseil indépendant en gestion de patrimoine'} />
  <meta property="og:locale" content="fr_FR" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;1,400&family=Archivo:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <a class="skip-link" href="#main">Aller au contenu</a>

  <div class="shell">
    <Topbar />
    <Header />
    <slot />
    <Footer />
    <ActionBar />
  </div>

  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
